{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the main window is allowed to do. Nothing else is reachable from the webview.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "clipboard-manager:allow-write-text",
    "allow-list-dir",
    "allow-stat-path",
    "allow-child-count",
    "allow-create-dir",
    "allow-rename-path",
    "allow-list-folder-icons",
    "allow-set-folder-icon",
    "allow-get-places",
    "allow-path-properties",
    "allow-start-folder-usage",
    "allow-cancel-folder-usage",
    "allow-initial-location",
    "allow-list-drives",
    "allow-desktop-info",
    "allow-default-app-status",
    "allow-make-default-app",
    "allow-restore-default-app",
    "allow-check-update",
    "allow-enqueue-job",
    "allow-pause-job",
    "allow-resume-job",
    "allow-cancel-job",
    "allow-list-jobs",
    "allow-list-trash",
    "allow-restore-trash",
    "allow-purge-trash",
    "allow-empty-trash",
    "allow-start-search",
    "allow-cancel-search",
    "allow-watch-dirs",
    "allow-get-theme",
    "allow-load-settings",
    "allow-save-settings",
    "allow-open-path",
    "allow-open-terminal"
  ]
}
